# Pinned versions
NODE_VERSION=24.18.0
NEXT_VERSION=16.2.11
BETTER_AUTH_VERSION=1.6.25
JAVA_VERSION=21
MAVEN_VERSION=3.9.16
SPRING_BOOT_VERSION=4.1.0
POSTGRES_VERSION=18.4
KEYCLOAK_VERSION=26.7.0
MAILPIT_VERSION=v1.30.5
AZURITE_VERSION=3.36.0
PLAYWRIGHT_VERSION=1.62.0
# General
COMPOSE_PROJECT_NAME=workflow

# Frontend
NEXT_PUBLIC_APP_NAME=ワークフローシステム
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BACKEND_INTERNAL_URL=http://backend:8080

# Keycloak OIDC
KEYCLOAK_EXTERNAL_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=workflow
KEYCLOAK_CLIENT_ID=workflow-web
KEYCLOAK_CLIENT_SECRET=replace-with-client-secret
KEYCLOAK_ISSUER=http://localhost:8180/realms/workflow
ALLOWED_EMAIL_DOMAIN=sdcj.co.jp
ALLOWED_EXTERNAL_EMAILS=guest00@example.com,guest01@example.com,guest02@example.com,guest03@example.com

# Keycloak administrator
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-admin-password

# PostgreSQL bootstrap administrator (not passed to application containers)
POSTGRES_ADMIN_PASSWORD=replace-with-postgres-admin-password

# Workflow database
WORKFLOW_DB_NAME=workflow
WORKFLOW_DB_USER=workflow
WORKFLOW_DB_PASSWORD=replace-with-workflow-db-password

# Keycloak database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-keycloak-db-password

# Development users (local development only)
DEV_ADMIN_EMAIL=example.admin1@sdcj.co.jp
DEV_ADMIN_PASSWORD=password
DEV_USER_EMAIL=example.user1@sdcj.co.jp
DEV_USER_PASSWORD=password
DEV_PENDING_EMAIL=example.pending1@sdcj.co.jp
DEV_PENDING_PASSWORD=password

# Development organization seed users (local development only)
DEV_SEED_PASSWORD=password
GUEST_SEED_PASSWORD=guest-password

# Mail
WORKFLOW_NOTIFICATION_DELIVERY_MODE=local-mailpit
WORKFLOW_DEPLOYMENT_ENVIRONMENT=development
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@workflow.local
MAILPIT_UI_PORT=8025
ACCESS_REQUEST_NOTIFICATION_COOLDOWN=15m
